# build scratch + fetched upstreams
/build/*
!/build/assemble.sh
!/build/build-static.sh
!/build/package.sh

# packaged output
/ksutools-*.zip

# generated payload (recreated by build/assemble.sh + build/package.sh)
module/system/bin/.ksutools/
module/system/etc/ssl/certs/

# 本地工作状态/日志（只跟踪 STATE.md）
.agent/*.log
.agent/*.log.new
.agent/tmp/
.agent/art*/
.agent/libc.so
.agent/linker64
