# build scratch + fetched upstreams
/build/*
!/build/assemble.sh
!/build/assemble-inner.sh
!/build/build-static.sh

# packaged output
/ksutools-*.zip

# generated payload (recreated by build/assemble.sh)
module/system/bin/.ksutools/
module/system/etc/ssl/certs/

# 本地工作状态/日志（只跟踪 STATE.md）
.agent/*.log
.agent/tmp/
