#!/system/bin/sh
# ksutools launcher: sets the few env vars the tools cannot guess, then execs
# the real (statically linked) binary. Every command in system/bin is a
# symlink to this file; the tool name comes from the symlink's basename.
#
# The binaries are static musl builds on purpose: /system/bin lives in an
# overlay and a dynamic musl binary would need the /system/lib64 overlay,
# which is a separate mount and invisible from other namespaces.

KSUROOT=/system/bin/.ksutools
name=${0##*/}

export SSL_CERT_FILE=/system/etc/ssl/certs/ca-certificates.crt
export SSL_CERT_DIR=/system/etc/ssl/certs
export TMPDIR=/data/local/tmp
[ -n "$HOME" ] || export HOME=/data/adb/ksutools/home/root

# sshd: default to the persistent config unless the caller passes -f.
if [ "$name" = sshd ]; then
	case " $* " in
		*" -f "*) ;;
		*) set -- -f /data/adb/ksutools/etc/ssh/sshd_config "$@" ;;
	esac
fi

exec "$KSUROOT/$name" "$@"
